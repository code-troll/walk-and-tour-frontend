NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
BOOKING_REQUEST_FROM_EMAIL=
BOOKING_REQUEST_TO_EMAIL=
CONTACT_FORM_FROM_EMAIL=
CONTACT_FORM_TO_EMAIL=

# Backend API and Auth0. Required by the backoffice and the hotel portal.
BACKEND_API_BASE_URL=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
BACKEND_AUTH0_AUDIENCE=
# Comma-separated list of every origin Auth0 may return to, so it must include
# each portal host you run locally.
APP_BASE_URL=http://dev.walkandtour.dk:3001,http://admin.dev.walkandtour.dk:3001,http://hotels.dev.walkandtour.dk:3001
# Auth0 database connection holding hotel access users. Pins the hotel portal's
# sign-in form to the right connection.
AUTH0_HOTEL_CONNECTION=Hotel-Portal-Users

# Never set AUTH0_COOKIE_DOMAIN. The session cookie is host-scoped, which is
# what keeps a backoffice session and a hotel portal session apart. Pointing it
# at a shared parent domain silently merges the two.
